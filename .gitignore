# Operating system and editor artifacts
.DS_Store
Thumbs.db
*.swp
*~

# Local scratch and logs
*.log
tmp/

# Generated Docpact diagnostics; disposable reports, not governed source.
# Do not ignore .docpact/ itself: config.yaml is governed.
.docpact/runs/

# Dependencies for the development toolchain. The published package has no
# runtime dependency and never carries this directory.
node_modules/

# Disposable build output: archive staging, the candidate archive binding
# record, and any scratch a build or a pack run produces. The reviewed release
# artifact under release/ is NOT ignored; it is committed so the exact bytes a
# downstream step consumes are reviewable in the repository.
build/
