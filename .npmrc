# The specification package is asset-only. Lockfile-exact installs keep the
# development toolchain reproducible without making it part of the package.
auto-install-peers=false
strict-peer-dependencies=true
save-exact=true

# Fail rather than warn when the running Node does not satisfy `engines.node`.
# pnpm does not enforce its own version this way, so the pnpm pin is enforced by
# `scripts/ci/require-toolchain.mjs` instead — see docs/qualification.md.
engine-strict=true

# The exact Node runtime a build uses. `engines.node` in package.json states the
# version consumers need; this pins the one a build runs under.
use-node-version=24.19.0
